{
  "buildCommand": "npm install",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/:subdomain", "destination": "/api/get-project" },
    { "source": "/:subdomain/", "destination": "/api/get-project" },
    { "source": "/:subdomain/(.*)", "destination": "/api/get-project" }
  ]
}
